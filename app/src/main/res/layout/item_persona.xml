<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:cardBackgroundColor="@color/surface_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquareImageView"
            app:strokeWidth="2dp"
            app:strokeColor="@color/primary_container"
            app:srcCompat="@drawable/ic_person_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/imgFoto"
            app:layout_constraintEnd_toStartOf="@id/btnEditar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Carlos González" />

        <TextView
            android:id="@+id/tvCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_cuenta"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/imgFoto"
            app:layout_constraintTop_toBottomOf="@id/tvNombre"
            tools:text="Cuenta: 20210001" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/imgFoto"
            app:layout_constraintEnd_toStartOf="@id/btnEditar"
            app:layout_constraintTop_toBottomOf="@id/tvCuenta"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/correo"
                android:src="@drawable/ic_email"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCorreo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="carlos.gonzalez@example.com" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_edit"
            android:contentDescription="@string/desc_editar"
            android:padding="9dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/edit_icon"
            app:layout_constraintEnd_toStartOf="@id/btnEliminar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_delete"
            android:contentDescription="@string/desc_eliminar"
            android:padding="9dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/delete_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>